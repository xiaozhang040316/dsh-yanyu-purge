{
  "name": "@local/dsh-yanyu-purge",
  "version": "1.4.1",
  "description": "燕子 · 破甲工作台｜把系统提示词，变成你的主场。红黄蓝绿四方案一键切换，支持 system 覆盖与追加、本地请求确认、动态状态与深浅主题。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "balance.js",
    "session-store.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "prompts/*.txt",
    "locale/*.json",
    "docs/INSTALL.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "author": "xiaozhang040316",
  "homepage": "https://github.com/xiaozhang040316/dsh-yanyu-purge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaozhang040316/dsh-yanyu-purge.git"
  },
  "bugs": {
    "url": "https://github.com/xiaozhang040316/dsh-yanyu-purge/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "yanyu",
    "prompt-manager"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/balance-test.mjs scripts/persistence-test.mjs scripts/session-store-test.mjs scripts/desktop-transport-test.mjs",
    "package": "python scripts/package.py"
  }
}
