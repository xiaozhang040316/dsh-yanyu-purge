{
  "name": "@local/dsh-yanyu-purge",
  "version": "1.3.0",
  "description": "燕子 · DSH 提示词工作台：红、黄、蓝、绿四种方案切换，实时注入状态与燕语 FreeCoding 品牌界面。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "prompts/*.txt",
    "locale/*.json",
    "docs/INSTALL.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "author": "xiaozhang040316",
  "homepage": "https://github.com/xiaozhang040316/dsh-yanyu-purge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaozhang040316/dsh-yanyu-purge.git"
  },
  "bugs": {
    "url": "https://github.com/xiaozhang040316/dsh-yanyu-purge/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "yanyu",
    "prompt-manager"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "package": "python scripts/package.py"
  }
}
